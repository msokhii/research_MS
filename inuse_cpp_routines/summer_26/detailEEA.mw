<Group hide-input="false" labelreference="L2" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">EEA := proc(argA::polynom, argB::polynom, x)
local r, s, t, q, k, n, degInfo, rem, lc;

  r[0], r[1] := argA, argB;
  s[0], s[1] := 1, 0;
  t[0], t[1] := 0, 1;
  k := 1;

  while r[k] &lt;&gt; 0 do
    q[k+1] := quo(r[k-1], r[k], x, 'rem');
    r[k+1] := rem;
    s[k+1] := expand(s[k-1] - q[k+1]*s[k]);
    t[k+1] := expand(t[k-1] - q[k+1]*t[k]);
    k := k + 1;
  od;

  n := k - 1;

  # make gcd monic
  lc := lcoeff(r[n], x);
  r[n] := expand(r[n]/lc);
  s[n] := expand(s[n]/lc);
  t[n] := expand(t[n]/lc);

  degInfo := table();
  for k from 0 to n do
    degInfo[k] := table([
      &quot;r&quot; = r[k],       &quot;deg_r&quot; = degree(r[k], x),
      &quot;s&quot; = s[k],       &quot;deg_s&quot; = degree(s[k], x),
      &quot;t&quot; = t[k],       &quot;deg_t&quot; = degree(t[k], x)
    ]);
    if k &gt;= 2 then
      degInfo[k][&quot;q&quot;]     := q[k];
      degInfo[k][&quot;deg_q&quot;] := degree(q[k], x);
    fi;
  od:
  degInfo := convert(degInfo,list):
  return r[n],degInfo:
end proc;</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
</Group>
