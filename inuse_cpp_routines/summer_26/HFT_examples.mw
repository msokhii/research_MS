<Group labelreference="L58" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">getUandM := proc(S::posint,p::prime)
local numEval,denEval,yVal,i,k,M,U:
    
yVal := table():
for i from 1 to S do
    denEval := Eval(g,x=i) mod p:
    if denEval=0 then
        return FAIL:                       
    fi:
    numEval := Eval(f,x=i) mod p:
    yVal[i] := numEval/denEval mod p:   
od:
yVal := convert(yVal,list):
M := Expand(mul(x-i,i=1..S)) mod p:        
U := Interp([seq(i,i=1..S)],yVal,x) mod p: 
return (M,U,yVal):
end proc:</Text-field>
