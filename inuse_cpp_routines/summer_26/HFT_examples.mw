<Group labelreference="L65" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">HFTRFR := proc(M,U,Delta)
local r,t,k,qMax,unqFlag,NS,DS,q,degQ,Lambda,f,g,mu,BLambda,i,fvals,gvals,mism:
if U = 0 then     return FAIL: fi:                           
r[0] := M:  r[1] := U:                                  
t[0] := 0:  t[1] := 1:
k := 1:  qMax := -1:  unqFlag := true:  NS := M:  DS := 1:
<Font encoding="UTF-8">printf(&quot;Iteration: %8s %8s %8s\134n&quot;, &quot;deg r_i&quot;, &quot;deg q_i&quot;, &quot;deg t_i&quot;):while r[k] &lt;&gt; 0 do                                       
    q[k] := Quo(r[k-1],r[k],x) mod p:    degQ := degree(q[k],x): 
    printf(&quot;%9a: %8a %8a %8a\134n&quot;, k, degree(r[k],x),degree(q[k],x),degree(t[k],x)):                 
    if degQ&gt;qMax then                        
        qMax := degQ:                          
        NS := r[k]:          DS := t[k]:          unqFlag := true:
    elif degQ=qMax then                      
        unqFlag := false:                                
    fi:
    r[k+1] := Expand(r[k-1]-q[k]*r[k]) mod p:            
    t[k+1] := Expand(t[k-1]-q[k]*t[k]) mod p:
    k := k+1:od:
print(qMax);if qMax&lt;Delta or unqFlag=false then     return FAIL: fi: 
print(NS):print(DS):Lambda := Gcd(NS,DS) mod p: print(Lambda):                           
if Rem(M,Lambda,x) mod p&lt;&gt;0 or degree(Lambda,x)&gt;E then     return FAIL: fi:
f := Quo(NS,Lambda,x) mod p:                           
g := Quo(DS,Lambda,x) mod p:
mu := lcoeff(g,x):
f := (1/mu)*f mod p:
g := (1/mu)*g mod p:

return f, g:                                  
end proc:</Font></Text-field>
</Input>
</Group>
